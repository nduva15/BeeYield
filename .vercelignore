# Whitelist frontend application and build essentials
!/src/**
!/public/**
!index.html
!package.json
!pnpm-lock.yaml
!vite.config.ts
!tsconfig*.json
!tailwind.config.*
!postcss.config.*
!components.json
!eslint.config.jsMethod Not Allowed

in generating report we have to generate report as we had resolved it a while back fix fully


# Exclude root-level backend services & microservices
/backend
/backend/**
/services
/services/**

# Exclude Cloud, DevOps & Container configs
/k8s
/k8s/**
/terraform
/terraform/**
/supabase
/supabase/**
/Dockerfile*
/docker-compose*
/deploy.sh
/Makefile
/render.yaml
*.ps1

# Exclude Submodules & Sync temps
/beeyield-companion
/repo-sync-temp
.gitmodules

# Exclude Developer & Agent Tooling
/.github
/.github/**
/.claude
/.claude/**
/scripts
/scripts/**
/tools
/tools/**
/tests
/tests/**
/docs
/docs/**
/.docs
/.docs/**

# Exclude Research Data, Large PDFs & Scratch
/output
/output/**
/scratch
/scratch/**
*.csv
*.sql

# Build Caches & Python artifacts
*.tsbuildinfo
__pycache__
*.pyc
.pytest_cache
.cache
.output
.vercel
dist

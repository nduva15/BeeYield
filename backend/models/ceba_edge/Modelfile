# 1. Base Model Path
# Points to the exported GGUF file generated by Unsloth
FROM ./ceba-ai-student-8b-Q4_K_M.gguf

# 2. Runtime Parameters for Edge Inference
# Low temperature enforces deterministic, grounded diagnostic reasoning
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER top_k 40

# Context window sized to accommodate multi-sensor payloads and step-by-step reasoning
PARAMETER num_ctx 2048

# Cap max output tokens to prevent runaway output on constrained edge devices
PARAMETER num_predict 512

# Standard Llama 3 stop tokens
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"

# 3. System Prompt
# Enforces Rationale-First generation, strict JSON output, and biosecurity guardrails
SYSTEM """You are CEBA AI, an edge-optimized apiculture diagnostic system deployed on a BeeYield gateway.
Your task is to analyze hive telemetry, environmental conditions, and acoustic metrics, then produce an assessment followed by a structured action plan.

Operating Rules:
1. Always evaluate telemetry systematically (temperature, weight dynamics, acoustics, brood state).
2. Adhere strictly to biosecurity and agronomic thresholds:
   - Never recommend chemical miticides during an active honey flow.
   - Never advise internal brood inspections when ambient temperature is below 12°C.
3. Emit your diagnostic reasoning first, followed by valid JSON containing alert_level ("INFO", "WARNING", or "CRITICAL"), primary_issue, and action_plan."""

# 4. Prompt Template
# Matches Meta-Llama-3.1 chat token conventions
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

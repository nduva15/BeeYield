# ============================================
# BeeYield Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git!

# ============ SUPABASE (Required) ============
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Backend compatibility (same values as above)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ============ POSTGRES (Required - from Supabase) ============
# Get these from: Supabase Dashboard → Settings → Database
POSTGRES_URL=postgres://postgres.PROJECT_ID:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://postgres.PROJECT_ID:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.PROJECT_ID:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_USER=postgres
POSTGRES_HOST=db.PROJECT_ID.supabase.co
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=postgres
DATABASE_URL=postgres://postgres.PROJECT_ID:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ============ CLICKHOUSE (Required for Analytics) ============
# Get these from: https://clickhouse.cloud or your ClickHouse instance
CLICKHOUSE_HOST=your-clickhouse-host.clickhouse.cloud
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=True
CLICKHOUSE_DATABASE=beeyield_analytics

# ============ APP SETTINGS (Required) ============
# Development
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Production - Update these when deploying
# VITE_APP_URL=https://yourdomain.com
# VITE_API_URL=/api/v1

# ============ SECURITY (Required) ============
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GENERATE_A_RANDOM_64_CHAR_STRING_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ============ PAYMENTS (Optional) ============
# Stripe - Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# M-Pesa (Safaricom) - Get from: https://developer.safaricom.co.ke
# MPESA_CONSUMER_KEY=your_mpesa_consumer_key
# MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
# MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# MPESA_BUSINESS_SHORTCODE=your_shortcode
# MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/shop/checkout/callback/mpesa

# ============ EMAIL SERVICE (Optional) ============
# Option 1: SMTP (Gmail, SendGrid, etc.)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_EMAIL=noreply@beeyield.com

# Option 2: Resend (Recommended) - Get from: https://resend.com
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM_ADDRESS=noreply@beeyield.com
# EMAIL_FROM_NAME=BeeYield

# ============ BLOCKCHAIN (Optional) ============
# Only needed if using external blockchain (Ethereum/Polygon)
# The app uses a Python blockchain by default
# BLOCKCHAIN_URL=http://127.0.0.1:8545
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_PRIVATE_KEY=0x...
# BLOCKCHAIN_ACCOUNT=0x...

# ============ STORAGE BUCKETS ============
# These are created in Supabase Storage
STORAGE_BUCKET_RESUMES=resumes
STORAGE_BUCKET_PRODUCTS=product-images
STORAGE_BUCKET_MEDIA=media

# ============ DEBUG MODE ============
DEBUG=True
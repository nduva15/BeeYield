# BeeYield Frontend - Multi-stage Docker Build
# This Dockerfile builds a production-ready frontend with Vite, Tailwind CSS, and React
# Environment variables are baked into the build and available at runtime in the browser

FROM node:20-alpine AS deps

RUN apk upgrade --no-cache

WORKDIR /app

# Install pnpm package manager
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy dependency files
COPY package.json pnpm-lock.yaml ./

# Install dependencies with mount cache for faster rebuilds
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ============================================================================
# BUILD STAGE - Compile TypeScript, React, and CSS
# ============================================================================
FROM node:20-alpine AS builder

RUN apk upgrade --no-cache

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# ============================================================================
# BUILD ARGUMENTS - Environment Configuration
# ============================================================================
# These are passed during `docker build --build-arg KEY=VALUE`
# They must be prefixed with VITE_ to be available in the browser
# ============================================================================

# Base Supabase Configuration (Shop/Auth)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

# BeeYield Backend (Hives, IoT, Farmers)
ARG VITE_SUPABASE_URL_BEEYIELD
ARG VITE_SUPABASE_ANON_KEY_BEEYIELD

# CEBA Backend (Content, Admin Dashboard)
ARG VITE_SUPABASE_URL_CEBA
ARG VITE_SUPABASE_ANON_KEY_CEBA

# API Configuration
ARG VITE_API_URL

# Stripe Configuration
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_STRIPE_API_URL

# Admin Configuration
ARG VITE_SUPER_ADMIN_EMAIL

# Optional Analytics
ARG VITE_VERCEL_ANALYTICS_ID
ARG VITE_SENTRY_DSN

# ============================================================================
# SET ENVIRONMENT - Variables available during build
# ============================================================================
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
ENV VITE_SUPABASE_URL_BEEYIELD=${VITE_SUPABASE_URL_BEEYIELD}
ENV VITE_SUPABASE_ANON_KEY_BEEYIELD=${VITE_SUPABASE_ANON_KEY_BEEYIELD}
ENV VITE_SUPABASE_URL_CEBA=${VITE_SUPABASE_URL_CEBA}
ENV VITE_SUPABASE_ANON_KEY_CEBA=${VITE_SUPABASE_ANON_KEY_CEBA}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}
ENV VITE_STRIPE_API_URL=${VITE_STRIPE_API_URL}
ENV VITE_SUPER_ADMIN_EMAIL=${VITE_SUPER_ADMIN_EMAIL}
ENV VITE_VERCEL_ANALYTICS_ID=${VITE_VERCEL_ANALYTICS_ID}
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}

# Build the application
# Vite automatically injects VITE_ prefixed env vars into the client bundle
RUN pnpm run build

# ============================================================================
# PRODUCTION STAGE - Nginx web server
# ============================================================================
FROM nginx:1.31-alpine

# Patch all OS-level CVEs (openssl, libxml2, libpng, musl, zlib, nghttp2)
RUN apk upgrade --no-cache

# Set working directory
WORKDIR /usr/share/nginx/html

# Copy built application from builder stage
COPY --from=builder /app/dist .

# ============================================================================
# NGINX CONFIGURATION
# ============================================================================
# Create optimized nginx config with:
# - SPA routing (all requests go to index.html for React Router)
# - Auth callback support
# - Security headers
# - Gzip compression
# - Proper caching policies
# ============================================================================
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    
    # Allow large file uploads (e.g., images, documents)
    client_max_body_size 10M;
    
    # ====== COMPRESSION ======
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types 
        text/plain 
        text/css 
        text/xml 
        text/javascript 
        application/x-javascript 
        application/xml+rss 
        application/javascript 
        application/json
        application/wasm;
    
    # ====== SECURITY HEADERS ======
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    
    # ====== SPA ROUTING ======
    # All requests go to index.html for React Router to handle
    # This enables client-side routing for all paths
    location / {
        # Don't cache HTML - browser must always check for updates
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        
        # Try to serve file, then directory, fall back to index.html
        try_files $uri $uri/ /index.html;
    }
    
    # ====== AUTH CALLBACK ======
    # Supabase auth redirects to /auth/callback - ensure it goes through SPA
    location /auth/callback {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri $uri/ /index.html;
    }
    
    # ====== API PROXY (Optional) ======
    # Forward /api/* requests to backend service
    # Useful for local development or if backend is behind same domain
    location /api/ {
        proxy_pass http://backend:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
    }
    
    # ====== STATIC ASSETS ======
    # Cache built JS/CSS/images for 30 days (immutable in production)
    # Vite adds content hashes to filenames: app.abc123.js
    location ~* \.(js|css|jpg|jpeg|gif|png|svg|ico|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable, max-age=2592000" always;
    }
    
    # ====== SERVICE WORKER & MANIFEST ======
    # Don't cache service worker or manifest - always check for updates
    location ~* \.(sw\.js|manifest\.json)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}
EOF

# Validate nginx configuration
RUN nginx -t

# ============================================================================
# HEALTHCHECK
# ============================================================================
# Docker uses this to determine if container is healthy
# Checks that nginx is serving index.html
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/index.html || exit 1

# ============================================================================
# EXPOSE
# ============================================================================
EXPOSE 80

# ============================================================================
# START
# ============================================================================
# Run nginx in foreground (required for Docker containers)
# This keeps the container alive
CMD ["nginx", "-g", "daemon off;"]

# ============================================================================
# BUILD USAGE
# ============================================================================
# 
# Development Build (hot reload):
#   docker build --target builder -t beeyield-dev .
#   docker run -it -v $(pwd)/src:/app/src -p 5173:5173 beeyield-dev pnpm run dev
#
# Production Build with Environment Variables:
#   docker build \
#     --build-arg VITE_SUPABASE_URL=https://xxx.supabase.co \
#     --build-arg VITE_SUPABASE_ANON_KEY=your-key \
#     --build-arg VITE_SUPABASE_URL_BEEYIELD=https://beeyield.supabase.co \
#     --build-arg VITE_SUPABASE_ANON_KEY_BEEYIELD=beeyield-key \
#     --build-arg VITE_API_URL=https://api.beeyield.com \
#     --build-arg VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx \
#     --build-arg VITE_SUPER_ADMIN_EMAIL=admin@beeyield.com \
#     -t beeyield-frontend:v1.0.0 .
#   
#   docker run -d -p 3000:80 beeyield-frontend:v1.0.0
#
# With Docker Compose (see docker-compose.yml for full example):
#   docker compose up --build
#

# ============================================
# BEEYIELD DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill in your credentials

# ============================================
# SUPABASE CONFIGURATION (Base / Shared)
# ============================================
# This is your main Supabase project URL and API key
# Get these from: https://app.supabase.com/project/[project-ref]/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# SUPABASE BACKEND OVERRIDES (Optional)
# If you have separate Supabase projects per backend
# ============================================

# Shop backend (e-commerce, customers, orders)
VITE_SUPABASE_URL_SHOP=https://shop-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY_SHOP=shop-anon-key-here

# BeeYield backend (hives, IoT, farmers)
VITE_SUPABASE_URL_BEEYIELD=https://beeyield-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY_BEEYIELD=beeyield-anon-key-here

# CEBA backend (content, admin, dashboard)
VITE_SUPABASE_URL_CEBA=https://ceba-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY_CEBA=ceba-anon-key-here

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL (used for backend-to-backend calls)
VITE_API_URL=http://backend:8000

# ============================================
# STRIPE CONFIGURATION (Payment Processing)
# ============================================
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
VITE_STRIPE_API_URL=https://api.stripe.com/v1

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Email address that gets super admin access
VITE_SUPER_ADMIN_EMAIL=admin@example.com

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================
VITE_VERCEL_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ============================================
# EXTERNAL APIs (Optional)
# ============================================
VITE_WEATHER_API_KEY=
VITE_MAP_TILES_URL=

# ============================================
# DATABASE CONFIGURATION (Backend)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/beeyield
POSTGRES_DB=beeyield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
